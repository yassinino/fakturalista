APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=test
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Receives the internal "new self-service registration" notification -
# see App\Mail\AdminNewRegistrationMail / config/fakturalista.php.
FAKTURALISTA_ADMIN_EMAIL=admin@fakturalista.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Gemini API (AI Invoice feature) - console.cloud.google.com > AI Studio > Get API key. Free tier.
GEMINI_API_KEY=

# AI blog automation (php artisan blog:generate-daily) - reuses GEMINI_API_KEY /
# GEMINI_MODEL. On/off switches live in the backoffice (Blog IA), off by default.
# BLOG_AI_GROUNDING=true          # Google Search grounding (needed to verify regulatory sources)
# BLOG_AI_CHECK_LINKS=true        # drop cited external links that don't answer
# BLOG_AI_TIMEOUT=120
# BLOG_AI_MAX_OUTPUT_TOKENS=16384
# BLOG_AUTOMATION_QUEUE=default
# Optional cost estimate, USD per million tokens (copy from Google's price list for your model):
# BLOG_AI_PRICE_INPUT_PER_M=
# BLOG_AI_PRICE_OUTPUT_PER_M=
